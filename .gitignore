# ════════════════════════════════════════════════════════
# 敏感凭据（绝对不能提交）
# ════════════════════════════════════════════════════════
# 前导 / 只匹配根目录，不影响子项目（如 web/.env 是前端构建配置，应提交）
# 根目录真实密钥（LLM_KEYS / HERMES_API_KEY / JWT_SECRET）
/.env
# 本地私有覆盖（任何人本地可能有）
/.env.local
/.env.*.local

# ════════════════════════════════════════════════════════
# 数据与产物（体积大 / 含隐私 / 可重建）
# ════════════════════════════════════════════════════════
# 运行时数据：向量库、PostgreSQL 文件、MinerU 缓存、上传文件、导出文书
data/
# 嵌入/重排模型缓存（首次运行会自动下载 ~5GB）
models/
# 真实业务台账（企业清单、隐患汇总、整改单模板等 2.4M）
企业信息文件/
# 本地 SQLite / 其他数据库文件
*.db
*.sqlite
*.sqlite3

# ════════════════════════════════════════════════════════
# Python
# ════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
# 测试/类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ════════════════════════════════════════════════════════
# AI Agent 工作区（不上传到 git）
# ════════════════════════════════════════════════════════
.claude/
.trae/
.cursor/

# ════════════════════════════════════════════════════════
# 编辑器 & OS
# ════════════════════════════════════════════════════════
# JetBrains 全家桶（IDEA / PyCharm / WebStorm）
.idea/
*.iml
*.ipr
*.iws
# VS Code —— 全局忽略；项目级 settings.json 如果要共享可 .gitkeep 后手动 add -f
.vscode/
# macOS
.DS_Store
.AppleDouble
.LSOverride
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# vim / neovim 临时文件
*.swp
*.swo
*~

# ════════════════════════════════════════════════════════
# 日志
# ════════════════════════════════════════════════════════
*.log
npm-debug.log*
.pnpm-debug.log

# ════════════════════════════════════════════════════════
