# ── RAG 项目环境变量模板 ──────────────────────────────
# 用法: 复制本文件为 .env，填入真实值后 docker compose 会自动加载。
#       不要直接用本文件启动 —— 里面全是占位符。
#
# 分类说明：
#   [compose锁定]  —— docker-compose.yml 里硬编码，.env 写了也无效；
#                     改这些值需要直接改 compose 对应 service 的 environment 段。
#   [compose默认]  —— compose 里用 ${VAR:-default} 写法，.env 可以覆盖默认值。
#   [.env必填]     —— 影响安全/连接性，强烈建议在 .env 显式设置。
#
# Git 规则: .env 已在 .gitignore 里（含真实密钥），本文件提交用于给他人参考。

# ════════════════════════════════════════════════════════
# 端口（compose默认，可在 .env 覆盖）
# ════════════════════════════════════════════════════════
RAG_API_PORT=8000          # 业务后端 HTTP 端口（rag-api）
RAG_MCP_PORT=8001          # MCP Server 端口（rag-mcp）

# ════════════════════════════════════════════════════════
# 大模型
# ════════════════════════════════════════════════════════
# Ollama 本地 LLM [compose锁定，值写在 compose 里]
# OLLAMA_HOST=host.docker.internal
# OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=qwen3:8b
LLM_PROVIDER=ollama        # ollama | api

# 远程 API 备用（deepseek / openai 兼容） [compose默认]
API_DEFAULT_MODEL=deepseek-chat
API_DEFAULT_BASE=https://api.deepseek.com
# LLM_KEYS 必须是合法 JSON；多 provider 用逗号分隔，例如 {"deepseek":"sk-xxx","qwen":"sk-yyy"}
LLM_KEYS={"deepseek":"sk-YOUR-API-KEY-HERE"}

# ════════════════════════════════════════════════════════
# 嵌入 / 重排模型
# ════════════════════════════════════════════════════════
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# cuda / cpu；cpu 可释放 GPU 给本地 LLM
EMBED_DEVICE=cuda

# ════════════════════════════════════════════════════════
# Qdrant 向量库 [compose锁定，QDRANT_HOST/PORT 在 compose 里]
# ════════════════════════════════════════════════════════
QDRANT_COLLECTION=workfile        # 默认 collection；多集合在检索时显式传参

# ════════════════════════════════════════════════════════
# 文档处理
# ════════════════════════════════════════════════════════
CHUNK_SIZE=512
CHUNK_OVERLAP=50
# fixed（固定 token 数）/ semantic（按段落边界）—— semantic 适合公文合同
# CHUNK_METHOD=fixed
PDF_PARSER=mineru
MINERU_TIMEOUT=600
EXCLUDE_PATHS=不解析文件          # 跳过索引的目录，逗号分隔

# ════════════════════════════════════════════════════════
# MinerU PDF 解析 [compose锁定]
# ════════════════════════════════════════════════════════
# MINERU_HOST=mineru
# MINERU_PORT=8000
# MINERU_BACKEND=pipeline
# MINERU_LANG=ch
# MINERU_VRAM_THRESHOLD=0.65
# MINERU_RESTART_EVERY_N=10
# MINERU_PAGE_CHUNK_SIZE=20
# MINERU_MIN_CHUNK_SIZE=5
# MINERU_CHUNK_RESTART_EVERY=5

# ════════════════════════════════════════════════════════
# 检索参数 [compose默认]
# ════════════════════════════════════════════════════════
RETRIEVAL_TOP_K=30          # 初始召回条数（每路）
RERANK_TOP_K=5              # RRF 融合后送重排的条数
RERANK_BATCH_SIZE=16        # 重排模型批大小
AGGREGATE_TOP_K=30          # 跨库聚合最终返回条数
RRF_DENSE_WEIGHT=1.0        # RRF 融合权重（Dense 语义 / Sparse 关键词）
RRF_SPARSE_WEIGHT=1.0
HYDE_ENABLED=false          # 开启会额外多一次 LLM 调用

# ════════════════════════════════════════════════════════
# 多模态（图片 OCR / 描述）—— 默认关闭
# ════════════════════════════════════════════════════════
# MULTIMODAL_ENABLED=false
# MULTIMODAL_IMAGE_DIR=/app/data/images

# ════════════════════════════════════════════════════════
# API 鉴权 —— 不设则接口无 X-API-Key 校验
# ════════════════════════════════════════════════════════
# RAG_API_KEY=sk-your-secret-key

# ════════════════════════════════════════════════════════
# PostgreSQL 业务数据库 [.env必填]
# ════════════════════════════════════════════════════════
PG_USER=rag
PG_PASSWORD=rag_secret
PG_DB=rag
PG_PORT=5432
PG_POOL_SIZE=10

# ════════════════════════════════════════════════════════
# JWT 认证 [.env必填]
# ════════════════════════════════════════════════════════
# 生成方式: openssl rand -url 48   或   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_EXPIRE_HOURS=24

# ════════════════════════════════════════════════════════
# Hermes Agent API（智能问答流式代理）[.env必填]
# compose 里 HERMES_API_BASE 默认 http://hermes-webui:8642（容器网内）
# HERMES_API_KEY 必须与 Hermes 侧 ~/.hermes/.env 的 API_SERVER_KEY 一致
# ════════════════════════════════════════════════════════
HERMES_API_BASE=http://hermes-webui:8642
HERMES_API_KEY=your-hermes-api-server-key

# ════════════════════════════════════════════════════════
# 对话计费单价（人民币 / 百万 tokens）—— 用于前端费用换算
# ════════════════════════════════════════════════════════
CHAT_PRICE_INPUT_PER_M=2
CHAT_PRICE_OUTPUT_PER_M=8

# ════════════════════════════════════════════════════════
# 对话配额默认（管理员未覆盖时，非管理员日限额 ¥）
# Staff 表 chat_daily_limit_yuan=None 时走此默认值
# ════════════════════════════════════════════════════════
CHAT_DAILY_LIMIT_DEFAULT=1.0

# ════════════════════════════════════════════════════════
# 文书导出目录 [compose锁定]
# 容器重建会丢失历史文件；要持久化需在 compose volumes 段添加挂载
# ════════════════════════════════════════════════════════
# DOC_EXPORT_DIR=/app/data/exports/交办单
# DOC_EXPORT_DIR_REVIEW=/app/data/exports/复查意见书

# ════════════════════════════════════════════════════════
# 其他容器内硬编码路径（通常不需要改）
# ════════════════════════════════════════════════════════
# IMPORT_DIR=/app/data/uploads          上传/导入目录（宿主机 ./data/uploads 挂载）
# HF_HOME=/app/models                   模型缓存（宿主机 ./models 挂载）
# MCP_HOST=0.0.0.0                      MCP Server 绑定地址
# MCP_PORT=8001                          MCP Server 端口（同 RAG_MCP_PORT）
# NVIDIA_VISIBLE_DEVICES=all             可见 GPU 编号
