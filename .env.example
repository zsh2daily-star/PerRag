# ── RAG 项目环境变量 ──────────────────────────────
# 使用方式: docker compose 自动加载此文件

# Ollama 大模型（宿主机）
OLLAMA_DEFAULT_MODEL=qwen3-xlam:latest
LLM_PROVIDER=ollama

# API 远程模型（可选）
API_DEFAULT_MODEL=deepseek-chat
API_DEFAULT_BASE=https://api.deepseek.com
LLM_KEYS={"deepseek":xxxxxxxxxxxxxxxxxxx}

# 嵌入模型
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 文档处理
CHUNK_SIZE=512
CHUNK_OVERLAP=50
PDF_PARSER=mineru
MINERU_TIMEOUT=600

# 检索参数
RETRIEVAL_TOP_K=30
RERANK_TOP_K=5
RERANK_BATCH_SIZE=16

# Qdrant
QDRANT_COLLECTION=workFile

# 跳过索引的目录名（逗号分隔）
EXCLUDE_DIRS=安全

# 端口
RAG_API_PORT=8000
OPENWEBUI_PORT=3000

# Open WebUI
WEBUI_SECRET_KEY=change-me-in-production

# API 鉴权（取消注释并设置密钥后，所有接口需要 X-API-Key header）
# RAG_API_KEY=sk-your-secret-key

# RRF 融合权重（Dense 语义 / Sparse 关键词，默认均为 1.0）
# RRF_DENSE_WEIGHT=1.0
# RRF_SPARSE_WEIGHT=0.7

# HyDE 检索优化（检索前用 LLM 生成假设答案，提升抽象问题召回）
# HYDE_ENABLED=false

# 语义分块（按段落边界而非固定 token 数切分，适合公文/合同类文档）
# CHUNK_METHOD=fixed

# 多模态（启用 MinerU 图片提取和描述）
# MULTIMODAL_ENABLED=false
